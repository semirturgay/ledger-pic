# Copy to .env and fill in. Never commit .env.

# Long random string, at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Which vision model reads receipts: gemini (default) or claude.
EXTRACTION_PROVIDER=gemini

# Claude (https://console.anthropic.com). Haiku 5.5 is the cheapest current Claude model with vision.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Per model call.
AI_TIMEOUT_SECONDS=120
# Simultaneous model calls per worker.
AI_MAX_CONCURRENCY=4

# Used when running the backend outside Docker. docker compose overrides it to point at the db service.
# docker-compose creates the database with this password (only on first start of the volume).
# Postgres is published on 127.0.0.1 only. Use a long random value anywhere but your laptop.
POSTGRES_PASSWORD=
# For running the API/worker outside Docker; use the same password as above.
DATABASE_URL=postgresql+psycopg://ledgerpic:<POSTGRES_PASSWORD>@localhost:5432/ledgerpic

# Addresses of the reverse proxy allowed to set X-Forwarded-For (comma-separated IPs or CIDRs).
# Never '*': anyone could pick their own client IP and dodge rate limits. Leave unset with
# docker compose (it trusts only its own tunnel service, 172.28.0.10); on a cloud host, set your
# platform's proxy range. uvicorn's own default is loopback only.
# FORWARDED_ALLOW_IPS=

# docker compose publishes the API on 127.0.0.1 only; set 0.0.0.0 to test from a phone on your Wi-Fi.
# (On Docker Desktop, LAN devices then all arrive from one gateway address and share the per-IP
# login limit. Fine for testing; use the tunnel service for anything public.)
API_BIND=127.0.0.1
# Interactive API docs at /docs and /openapi.json. Set true for local development; keep false in production.
API_DOCS=false
# Hostnames the Turnstile check must have been solved on (your frontend's), comma-separated.
TURNSTILE_HOSTNAMES=
# Model jobs per day across all users (uploads + re-runs), a ceiling on AI spend.
AI_JOBS_PER_DAY_TOTAL=2000

# Comma-separated frontend origins allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:3000
# Optional regex for extra origins, e.g. Vercel preview deployments of your project only. Anchor it to your
# team slug: ^https://ledgerpic-[a-z0-9-]+-<your-team>\.vercel\.app$ (a bare ledgerpic-.* matches anyone's project).
CORS_ORIGIN_REGEX=

# Upload limit in bytes (10 MB) and the longest image edge kept after downscaling.
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_EDGE=1600

# Cloudflare Turnstile (human check on log in / register). Empty = off. Set both keys or neither.
# Cloudflare's always-pass test keys: secret 1x0000000000000000000000000000000AA, site key 1x00000000000000000000AA
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The web app (docker compose builds it). Where the browser finds the API; rebuild after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000
