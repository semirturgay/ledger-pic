# Base URL of the backend API, no trailing slash. Local: http://localhost:8000
# On Vercel: your deployed backend URL, or your tunnel URL (e.g. https://xxxx.ngrok-free.app).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: your machine LAN IP, to open the dev server from a phone on the same Wi-Fi
# (then also set NEXT_PUBLIC_API_URL to http://<that IP>:8000 and add http://<that IP>:3000 to CORS_ORIGINS).
DEV_LAN_HOST=

# Optional: Cloudflare Turnstile site key for the human check on log in / register.
# Pair it with TURNSTILE_SECRET_KEY on the backend. Cloudflare's always-pass test key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
